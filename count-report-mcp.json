{
  "name": "Count Report MCP",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 3 1 1 *"
            }
          ]
        }
      },
      "id": "b1000000-0000-4000-8000-000000000001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "https://abbiescigars.phppointofsale.com/index.php/api/v1/reports/summary_count_report",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "start_date", "value": "2026-06-01" },
            { "name": "end_date", "value": "2026-09-30" },
            { "name": "limit", "value": "100" },
            { "name": "offset", "value": "0" }
          ]
        },
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000002",
      "name": "Fetch Count Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\n\nconst payload = {\n  meta: {\n    endpoint: 'reports/summary_count_report',\n    start_date: '2026-06-01',\n    end_date: '2026-09-30',\n    pulled_at: new Date().toISOString(),\n    row_count: rows.length\n  },\n  raw: rows\n};\n\nreturn [{ json: { content: JSON.stringify(payload, null, 2) } }];"
      },
      "id": "b1000000-0000-4000-8000-000000000003",
      "name": "Build File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "create",
        "owner": {
          "__rl": true,
          "value": "1JKT1",
          "mode": "name"
        },
        "repository": {
          "__rl": true,
          "value": "abbies-data",
          "mode": "name"
        },
        "filePath": "business-decisions-data/count-report-raw.json",
        "fileContent": "={{ $json.content }}",
        "commitMessage": "Count report raw pull"
      },
      "id": "b1000000-0000-4000-8000-000000000004",
      "name": "Create Raw File",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [660, 0],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "edit",
        "owner": {
          "__rl": true,
          "value": "1JKT1",
          "mode": "name"
        },
        "repository": {
          "__rl": true,
          "value": "abbies-data",
          "mode": "name"
        },
        "filePath": "business-decisions-data/count-report-raw.json",
        "fileContent": "={{ $('Build File').item.json.content }}",
        "commitMessage": "Count report raw pull [rerun]"
      },
      "id": "b1000000-0000-4000-8000-000000000005",
      "name": "Update Raw File",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [880, 100]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [[{ "node": "Fetch Count Report", "type": "main", "index": 0 }]]
    },
    "Fetch Count Report": {
      "main": [[{ "node": "Build File", "type": "main", "index": 0 }]]
    },
    "Build File": {
      "main": [[{ "node": "Create Raw File", "type": "main", "index": 0 }]]
    },
    "Create Raw File": {
      "main": [
        [],
        [{ "node": "Update Raw File", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/New_York"
  }
}
